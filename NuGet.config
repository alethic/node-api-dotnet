<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Alethic.LibNode (libnode and node-dotnet, https://github.com/alethic/libnode-dotnet). GitHub Packages
      requires authentication even to read, and NuGet does not expand environment variables in
      packageSourceCredentials, so credentials live in your user-level NuGet.Config under this source's
      key (CI: `dotnet nuget update source alethic` with GITHUB_TOKEN). Do not add packageSourceMapping:
      the test harness restores from a local package source for the freshly built NodeApi packages.
    -->
    <add key="alethic" value="https://nuget.pkg.github.com/alethic/index.json" />
  </packageSources>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Alethic.LibNode* native packages, built by https://github.com/alethic/libnode. -->
    <add key="alethic" value="https://nuget.pkg.github.com/alethic/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="alethic">
      <package pattern="Alethic.*" />
    </packageSource>
  </packageSourceMapping>
  <!--
    GitHub Packages requires a token even to download. Locally: a token with read:packages, e.g.
    `gh auth refresh -s read:packages` then set GITHUB_PACKAGES_TOKEN to `gh auth token`.
    CI: GITHUB_TOKEN. The username is not checked.
  -->
  <packageSourceCredentials>
    <alethic>
      <add key="Username" value="alethic" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </alethic>
  </packageSourceCredentials>
</configuration>

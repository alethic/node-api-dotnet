<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      The Alethic.LibNode* native packages (https://github.com/alethic/libnode) come from the alethic
      GitHub Packages registry, https://nuget.pkg.github.com/alethic/index.json, which requires a token
      even to download (locally: `gh auth refresh -s read:packages`; CI: GITHUB_TOKEN). That source is
      added here when those packages are referenced. Do not add packageSourceMapping: the test harness
      restores from a local package source for the freshly built Microsoft.JavaScript.NodeApi packages.
    -->
  </packageSources>
</configuration>

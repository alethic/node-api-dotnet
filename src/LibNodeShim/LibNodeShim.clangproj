<Project>
    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.props" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\targets\lib.props" />

    <!--
        libnode embedding shim: a C ABI that mirrors Node's public C++ embedding API (node.h) and the
        small slice of v8.h an embedder needs (locker, isolate/handle/context scopes), 1:1, so that
        NodejsRuntime.Embedding.cs can P/Invoke it. Compiled with the same LLVM as libnode itself.

        Inputs come from the Alethic.LibNode packages (build/native/*.props):
            LibNodeIncludeDir            include/ from the top-level package (node.h, v8.h, uv.h, cppgc/)
            LibNodeBuildDir_<rid>        libnode.lib (Windows) and config.gypi for the RID
            LibNodeNativeDir_<rid>       libnode.{dll,so,dylib} for the RID
        or, before the packages exist, from LibNode.local.props (git-ignored; see LibNode.local.props.example).
    -->

    <PropertyGroup>
        <TargetName>nodeshim</TargetName>
        <OutputType>dll</OutputType>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)LibNode.local.props" Condition="Exists('$(MSBuildThisFileDirectory)LibNode.local.props')" />

    <!-- Pick this RID's libnode directories (MSBuild cannot nest property references). -->
    <PropertyGroup>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'win-x64' ">$(LibNodeBuildDir_win_x64)</LibNodeBuildDir>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'win-arm64' ">$(LibNodeBuildDir_win_arm64)</LibNodeBuildDir>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'linux-x64' ">$(LibNodeBuildDir_linux_x64)</LibNodeBuildDir>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'linux-arm64' ">$(LibNodeBuildDir_linux_arm64)</LibNodeBuildDir>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'osx-x64' ">$(LibNodeBuildDir_osx_x64)</LibNodeBuildDir>
        <LibNodeBuildDir Condition=" '$(TargetIdentifier)' == 'osx-arm64' ">$(LibNodeBuildDir_osx_arm64)</LibNodeBuildDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'win-x64' ">$(LibNodeNativeDir_win_x64)</LibNodeNativeDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'win-arm64' ">$(LibNodeNativeDir_win_arm64)</LibNodeNativeDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'linux-x64' ">$(LibNodeNativeDir_linux_x64)</LibNodeNativeDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'linux-arm64' ">$(LibNodeNativeDir_linux_arm64)</LibNodeNativeDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'osx-x64' ">$(LibNodeNativeDir_osx_x64)</LibNodeNativeDir>
        <LibNodeNativeDir Condition=" '$(TargetIdentifier)' == 'osx-arm64' ">$(LibNodeNativeDir_osx_arm64)</LibNodeNativeDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Sources: the SDK's default items pick up *.cc in this directory. -->
        <!-- install.py layout: everything under include/node/ (node.h, v8.h, uv.h, node_api.h, cppgc/...). -->
        <IncludeDirectories Include="$(LibNodeIncludeDir)node" />
        <!-- Consumer of a shared libnode: NODE_EXTERN/V8_EXPORT/UV_EXTERN become imports. -->
        <PreprocessorDefinitions Include="BUILDING_NODE_EXTENSION;USING_V8_SHARED;USING_V8_PLATFORM_SHARED;USING_UV_SHARED" />
        <PreprocessorDefinitions Include="NODESHIM_EXPORTS" />
        <AdditionalCompileOptions Include="-std=c++20;-fno-exceptions;-Wall" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetIdentifier.StartsWith('win-'))">
        <LibraryDirectories Include="$(LibNodeBuildDir)" />
        <Dependencies Include="libnode" />
    </ItemGroup>
    <ItemGroup Condition="!$(TargetIdentifier.StartsWith('win-'))">
        <LibraryDirectories Include="$(LibNodeNativeDir)" />
        <Dependencies Include="node" />
    </ItemGroup>

    <Target Name="_CheckLibNodeInputs" BeforeTargets="Build">
        <Error Condition=" '$(LibNodeIncludeDir)' == '' OR !Exists('$(LibNodeIncludeDir)node\node.h') " Text="LibNodeIncludeDir ('$(LibNodeIncludeDir)') does not contain node/node.h. Reference the Alethic.LibNode package or create LibNode.local.props (see LibNode.local.props.example)." />
    </Target>

    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.targets" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\targets\lib.targets" />
</Project>

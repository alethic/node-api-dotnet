<!--
    Copy to LibNode.local.props (git-ignored) to build the shim against a local libnode build
    instead of the Alethic.LibNode packages. Paths follow the alethic/libnode-dotnet layout.
-->
<Project>
    <PropertyGroup>
        <LibNodeIncludeDir>D:\libnode\out\libnode\include\</LibNodeIncludeDir>
        <LibNodeLibDir_win_x64>D:\libnode\ext\node\out\Release\</LibNodeLibDir_win_x64>
        <LibNodeNativeDir_win_x64>D:\libnode\ext\node\out\Release\</LibNodeNativeDir_win_x64>
    </PropertyGroup>
</Project>

<Project>
    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.props" />

    <!--
        libnode embedding shim: a C ABI that mirrors Node's public C++ embedding API (node.h) and the
        slice of v8.h an embedder needs (locker, isolate/handle/context scopes), 1:1, so that
        LibNodeShim.cs can P/Invoke it. Compiled with the same LLVM as libnode itself.

        Built per runtime identifier like IKVM's lib* projects; the target and sysroot settings are
        IKVM's targets/lib.props and lib.targets, for the runtimes this repository supports.

        libnode inputs, as defined by the Alethic.LibNode packages or, until those are referenced, by
        LibNode.local.props (git-ignored; see LibNode.local.props.example):
            LibNodeIncludeDir             include/ (node/node.h, v8.h, uv.h, cppgc/...)
            LibNodeLibDir_<rid>           libnode.lib (Windows)
            LibNodeNativeDir_<rid>        libnode.so / libnode.dylib (Linux, macOS)
    -->

    <PropertyGroup>
        <TargetName>nodeshim</TargetName>
        <OutputType>dll</OutputType>
        <Verbose>true</Verbose>
        <DebugSymbols>true</DebugSymbols>
        <TargetIdentifiers>$(_SupportedRuntimes)</TargetIdentifiers>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'win-x64' ">x86_64-pc-windows-msvc</TargetTriple>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'win-arm64' ">aarch64-pc-windows-msvc</TargetTriple>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'linux-x64' ">x86_64-unknown-linux-gnu</TargetTriple>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'linux-arm64' ">aarch64-unknown-linux-gnu</TargetTriple>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'osx-x64' ">x86_64-apple-macosx</TargetTriple>
        <TargetTriple Condition=" '$(TargetIdentifier)' == 'osx-arm64' ">arm64-apple-macosx</TargetTriple>
        <IkvmNativeSdkDir>$(MSBuildThisFileDirectory)..\..\ext\ikvm-native-sdk\</IkvmNativeSdkDir>
    </PropertyGroup>

    <ItemGroup>
        <PreprocessorDefinitions Include="_AMD64_;amd64" Condition="$(TargetIdentifier.EndsWith('-x64'))" />
        <PreprocessorDefinitions Include="_ARM64_;arm64" Condition="$(TargetIdentifier.EndsWith('-arm64'))" />
        <AdditionalCompileOptions Include="-Wno-ignored-attributes;-Wno-format;-Wno-format-security;-Wno-macro-redefined" />
    </ItemGroup>

    <!-- Windows -->

    <ItemGroup Condition=" '$(TargetIdentifier)' == 'win-arm64' ">
        <PreprocessorDefinitions Include="_ARM_WINAPI_PARTITION_DESKTOP_SDK_AVAILABLE" />
    </ItemGroup>

    <PropertyGroup Condition="$(TargetIdentifier.StartsWith('win-'))">
        <MsCompatibility>true</MsCompatibility>
        <WinSdkArch Condition="$(TargetIdentifier.EndsWith('-x64'))">x64</WinSdkArch>
        <WinSdkArch Condition="$(TargetIdentifier.EndsWith('-arm64'))">arm64</WinSdkArch>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetIdentifier.StartsWith('win-'))">
        <PreprocessorDefinitions Include="_CRT_SECURE_NO_DEPRECATE;_CRT_NONSTDC_NO_DEPRECATE;WIN32;_MT;_DLL" />
        <AdditionalCompileOptions Include="-fms-extensions" />
        <AdditionalLinkOptions Include="-Wl,/NODEFAULTLIB:libucrt" />
        <Dependencies Include="ucrt;msvcrt;msvcprt;libvcruntime;kernel32" />
    </ItemGroup>

    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
        <WinSdkDirName>win</WinSdkDirName>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <WinSdkDirName>win.ci</WinSdkDirName>
    </PropertyGroup>

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) And $(TargetIdentifier.StartsWith('win-'))">
        <AdditionalCompileOptions Include="-nostdlibinc" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)\crt\include" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)\sdk\include\shared" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)\sdk\include\ucrt" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)\sdk\include\um" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)-local\crt\include" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)-local\sdk\include\shared" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)-local\sdk\include\ucrt" />
        <AdditionalCompileOptions Include="-idirafter;$(IkvmNativeSdkDir)$(WinSdkDirName)-local\sdk\include\um" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)\crt\lib\$(WinSdkArch)" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)\sdk\lib\ucrt\$(WinSdkArch)" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)\sdk\lib\um\$(WinSdkArch)" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)-local\crt\lib\$(WinSdkArch)" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)-local\sdk\lib\ucrt\$(WinSdkArch)" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)$(WinSdkDirName)-local\sdk\lib\um\$(WinSdkArch)" />
    </ItemGroup>

    <!-- Linux -->

    <PropertyGroup Condition="$(TargetIdentifier.StartsWith('linux-'))">
        <LinuxSdkDir>$(IkvmNativeSdkDir)$(TargetIdentifier)\</LinuxSdkDir>
        <PositionIndependentCode>true</PositionIndependentCode>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetIdentifier.StartsWith('linux-'))">
        <SystemRootDirectories Include="$(LinuxSdkDir)" />
        <SystemIncludeDirectories Include="$(LinuxSdkDir)\include" />
        <LibraryDirectories Include="$(LinuxSdkDir)\lib" />
        <PreprocessorDefinitions Include="LINUX;__linux__" />
        <Dependencies Include="c" />
        <AdditionalLinkOptions Include="-nostdlib" />
        <AdditionalLinkOptions Include="-Wl,--undefined-version" />
        <AdditionalLinkOptions Include="-Wl,-rpath,$ORIGIN" />
    </ItemGroup>

    <!-- macOS -->

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX')) And $(TargetIdentifier.StartsWith('osx-'))">
        <IncludeSystemRootDirectories Include="$(IkvmNativeSdkDir)osx" />
        <LibraryDirectories Include="$(IkvmNativeSdkDir)osx\usr\lib" />
    </ItemGroup>

    <PropertyGroup Condition="$(TargetIdentifier.StartsWith('osx-'))">
        <DebugSymbols>false</DebugSymbols>
        <EnableOSXCodeSign>true</EnableOSXCodeSign>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetIdentifier.StartsWith('osx-'))">
        <PreprocessorDefinitions Include="MACOSX;MACOS" />
        <Dependencies Include="c++" />
        <AdditionalCompileOptions Include="-mmacosx-version-min" Value="10.10" Separator="=" />
        <AdditionalLinkOptions Include="-t" />
        <AdditionalLinkOptions Include="-mmacosx-version-min" Value="10.10" Separator="=" />
        <AdditionalLinkOptions Include="-Wl,-rpath,@loader_path%2f." />
    </ItemGroup>

    <!-- libnode -->

    <Import Project="$(MSBuildThisFileDirectory)LibNode.local.props" Condition="Exists('$(MSBuildThisFileDirectory)LibNode.local.props')" />

    <PropertyGroup>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'win-x64' ">$(LibNodeLibDir_win_x64)</LibNodeLibDir>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'win-arm64' ">$(LibNodeLibDir_win_arm64)</LibNodeLibDir>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'linux-x64' ">$(LibNodeNativeDir_linux_x64)</LibNodeLibDir>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'linux-arm64' ">$(LibNodeNativeDir_linux_arm64)</LibNodeLibDir>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'osx-x64' ">$(LibNodeNativeDir_osx_x64)</LibNodeLibDir>
        <LibNodeLibDir Condition=" '$(TargetIdentifier)' == 'osx-arm64' ">$(LibNodeNativeDir_osx_arm64)</LibNodeLibDir>
    </PropertyGroup>

    <ItemGroup>
        <IncludeDirectories Include="$(LibNodeIncludeDir)node" />
        <LibraryDirectories Include="$(LibNodeLibDir)" />
        <!-- Consumer of a shared libnode: NODE_EXTERN/V8_EXPORT/UV_EXTERN become imports. -->
        <PreprocessorDefinitions Include="BUILDING_NODE_EXTENSION;USING_V8_SHARED;USING_V8_PLATFORM_SHARED;USING_UV_SHARED" />
        <PreprocessorDefinitions Include="NODESHIM_EXPORTS" />
        <AdditionalCompileOptions Include="-std=c++20;-fno-exceptions;-Wall" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetIdentifier.StartsWith('win-'))">
        <Dependencies Include="libnode" />
    </ItemGroup>

    <ItemGroup Condition="!$(TargetIdentifier.StartsWith('win-'))">
        <Dependencies Include="node" />
    </ItemGroup>

    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.targets" />

    <PropertyGroup Condition="$(TargetTriple.Contains('-apple-'))">
        <AdditionalLinkOptions>$(AdditionalLinkOptions);-Wl,-install_name,@rpath/lib$(TargetName).dylib</AdditionalLinkOptions>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\targets\ClangOSXCodeSign.targets" />
</Project>

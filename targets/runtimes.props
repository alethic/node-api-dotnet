<!--

    runtimes.props

    Runtime identifiers for native (IKVM.Clang) projects, in the shape IKVM's Directory.Build.props
    uses: SupportedRuntimes is every RID we ship; EnabledRuntimes is what this build compiles.

    IKVM defaults EnabledRuntimes to all of SupportedRuntimes because it cross-compiles everything
    through per-RID sysroots. Those are not wired up here yet, so the default is the host RID, taken
    from $(RuntimeIdentifier) as computed by rid.props (import that first). CI overrides
    EnabledRuntimes once sysroots are in place.

-->

<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
        <_RuntimesPropsImported>true</_RuntimesPropsImported>
    </PropertyGroup>

    <PropertyGroup>
        <SupportedRuntimes Condition=" '$(SupportedRuntimes)' == '' ">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</SupportedRuntimes>
        <EnabledRuntimes Condition=" '$(EnabledRuntimes)' == '' ">$(RuntimeIdentifier)</EnabledRuntimes>
        <_SupportedRuntimes>;$(SupportedRuntimes);</_SupportedRuntimes>
        <_EnabledRuntimes>;$(EnabledRuntimes);</_EnabledRuntimes>
    </PropertyGroup>
</Project>
